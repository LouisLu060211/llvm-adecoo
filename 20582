import torch, torch_npu, triton, triton.language as tl

@triton.jit
def k(In_ptr, Out_ptr, N, BLOCK: tl.constexpr):
    offs = tl.arange(0, BLOCK)
    mask = offs < N
    x = tl.load(In_ptr + offs, mask=mask, other=0.0)
    y = tl.maximum(x, 0.0)
    tl.store(Out_ptr + offs, y, mask=mask)

for dt in [torch.uint8, torch.int8, torch.int16, torch.int32]:
    N = 16
    a = torch.arange(N, dtype=torch.float32).npu()
    o = torch.zeros(N, dtype=dt).npu()
    try:
        k[(1,)](a, o, N, BLOCK=16)
        print(f"[OK]   {dt}")
    except Exception as e:
        print(f"[FAIL] {dt}: {str(e)[:200]}")
EOF
