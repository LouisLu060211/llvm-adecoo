```bash
git fetch upstream
git switch -c fix-xegpu-2d-matrix upstream/main
```

## 第 2 步：改代码

复制这一整块：

```bash
cat > /tmp/fixxg.py <<'PYEOF'
import sys, os
SRC = "mlir/lib/Conversion/XeGPUToXeVM/XeGPUToXeVM.cpp"
if not os.path.isfile(SRC):
    sys.exit("error: run from the root of your llvm-project checkout")
s = open(SRC).read()

OLD = """      if (auto vecType = dyn_cast<VectorType>(resType)) {
        assert(llvm::count_if(vecType.getShape(),
                              [](int64_t d) { return d != 1; }) <= 1 &&
               "Expected either 1D vector or nD with unit dimensions");
        resType = VectorType::get({vecType.getNumElements()},
                                  vecType.getElementType());
      }"""

NEW = """      if (auto vecType = dyn_cast<VectorType>(resType)) {
        // This pattern emits a single contiguous access, so the result has to
        // be flattenable to a 1D vector. A result with more than one non-unit
        // dimension is valid IR but is not something this lowering can
        // express, so bail out instead of asserting.
        if (llvm::count_if(vecType.getShape(),
                           [](int64_t d) { return d != 1; }) > 1)
          return rewriter.notifyMatchFailure(
              op, "Expected either a 1D result or an nD result with unit "
                  "dimensions.");
        resType = VectorType::get({vecType.getNumElements()},
                                  vecType.getElementType());
      }"""

n = s.count(OLD)
if n != 1:
    sys.exit("error: matched %d times, expected 1" % n)
open(SRC, "w").write(s.replace(OLD, NEW))
print("patched " + SRC)
PYEOF
python3 /tmp/fixxg.py
```

应该打印 `patched mlir/lib/Conversion/XeGPUToXeVM/XeGPUToXeVM.cpp`。

