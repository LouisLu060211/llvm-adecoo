# -*- coding: utf-8 -*-
"""
CP-0086: ContinuousLoad -> tl.dot (with shape padding/fallback) -> Where -> Split -> Gelu -> Cast -> ElemWiseAdd -> BroadcastStore
"""

import sys
import traceback
import math
import torch
import triton
import triton.language as tl


# ==========================================
# 1. Triton 算子定义
# ==========================================
@triton.jit
def complex_fusion_kernel(
        X_ptr, W_ptr, Bias_ptr, Out_ptr,
        M, N, K,
        IS_FLOAT: tl.constexpr,
        IS_BOOL: tl.constexpr,
        IS_UINT: tl.constexpr,
        BLOCK_M: tl.constexpr,
        BLOCK_N: tl.constexpr,
        BLOCK_K: tl.constexpr,
):
    pid_m = tl.program_id(axis=0)
    pid_n = tl.program_id(axis=1)

    # 矩阵乘法分块偏移
    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
    offs_k = tl.arange(0, BLOCK_K)

    # 累加器初始化 (全程使用 float32 保证精度和防溢出)
    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)

    # 循环计算 MatMul
    for k in range(0, K, BLOCK_K):
        a_ptrs = X_ptr + offs_m[:, None] * K + (k + offs_k[None, :])
        b_ptrs = W_ptr + (k + offs_k[:, None]) * N + offs_n[None, :]

        mask_a = (offs_m[:, None] < M) & ((k + offs_k[None, :]) < K)
        mask_b = ((k + offs_k[:, None]) < K) & (offs_n[None, :] < N)

        a = tl.load(a_ptrs, mask=mask_a, other=0.0)
        b = tl.load(b_ptrs, mask=mask_b, other=0.0)

        a_dot = a.to(tl.float32)
        b_dot = b.to(tl.float32)

        # 根据 BLOCK 大小安全选择计算方式（加括号避免链式布尔运算报错）
        if (BLOCK_M >= 16 and BLOCK_N >= 16) and BLOCK_K >= 16:
            acc += tl.dot(a_dot, b_dot)
        else:
            acc += tl.sum(a_dot[:, :, None] * b_dot[None, :, :], axis=0)

    # Where 条件选择 1
    if IS_BOOL:
        condition = acc != 0.0
        acc = tl.where(condition, acc, 0.0)
    else:
        condition = acc > 0.0
        acc = tl.where(condition, acc, acc * 0.1)

    # Gelu 激活函数实现
    if IS_FLOAT:
        inv_sqrt_2 = 0.7071067811865476
        gelu_out = 0.5 * acc * (1.0 + tl.math.erf(acc * inv_sqrt_2))
    else:
        gelu_out = acc

    # 连续加载偏置并进行逐元素加法
    bias_ptrs = Bias_ptr + offs_n[None, :]
    bias_mask = offs_n[None, :] < N
    bias_val = tl.load(bias_ptrs, mask=bias_mask, other=0.0).to(tl.float32)

    combined = gelu_out + bias_val

    # 模拟 Where 条件选择 2
    final_out = tl.where(combined > -100.0, combined, 0.0)

