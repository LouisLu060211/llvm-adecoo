The correct form quotes the whole option string:

```bash
cd /root/.triton/dump/WsImDyDq-V7lSIu-mslNv1-EEV0YyuQSLDwAqMNdkxY
bishengir-compile kernel.ttadapter.mlir --target=Ascend950PR_9579 \
  --enable-auto-multi-buffer=True --enable-auto-bind-sub-block=True --disable-ffts \
  --set-workspace-multibuffer=0 --limit-auto-multi-buffer-of-local-buffer=no-limit \
  --enable-vf-fusion=False --disable-auto-inject-block-sync=True \
  --enable-auto-blockify-loop --enable-hfusion-compile=true --enable-triton-kernel-compile=true \
  "--append-bisheng-options=-cce-link-aicore-ll-module /data/dev_conda/envs/louis_env/lib/python3.11/site-packages/triton/backends/ascend/lib/libdevice.10.bc" \
  --enable-vf-merge-level=1 \
  --mlir-print-ir-after-change --print-pass-id \
  -o /tmp/yaolu_kernel > /home/yaolu/bisheng_B4T1024_v2.log 2>&1
echo "exit: $?"
du -sh /home/yaolu/bisheng_B4T1024_v2.log
tail -5 /home/yaolu/bisheng_B4T1024_v2.log
```

