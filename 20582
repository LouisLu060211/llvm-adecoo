## 开新分支做 Vulkan 那个

```bash
git fetch upstream
git switch -c fix-vulkan-cout-precision upstream/main
```

然后改代码：

```bash
python3 - <<'PYEOF'
import sys, os
SRC = "mlir/lib/ExecutionEngine/VulkanRuntime.cpp"
if not os.path.isfile(SRC):
    sys.exit("error: run from the root of your llvm-project checkout")
s = open(SRC).read()

OLD = """    std::cout << "Compute shader execution time: " << std::setprecision(3)
              << microsec << "us\\n";"""

NEW = """    // std::setprecision is sticky on the stream, so save and restore the
    // caller's formatting state rather than leaving it changed.
    std::ios formatState(nullptr);
    formatState.copyfmt(std::cout);
    std::cout << "Compute shader execution time: " << std::setprecision(3)
              << microsec << "us\\n";
    std::cout.copyfmt(formatState);"""

n = s.count(OLD)
if n != 1:
    sys.exit("error: matched %d times, expected 1" % n)
open(SRC, "w").write(s.replace(OLD, NEW))
print("patched " + SRC)
PYEOF
```

先跑 `git log --oneline -2`，输出发我，我确认 PR 那边的状态。
